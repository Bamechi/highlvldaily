{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/daily/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/DAILY/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/daily/press/(.*)", "destination": "/press/$1" },
    { "source": "/DAILY/press/(.*)", "destination": "/press/$1" },
    { "source": "/daily", "destination": "/index.html" },
    { "source": "/daily/", "destination": "/index.html" },
    { "source": "/DAILY", "destination": "/index.html" },
    { "source": "/DAILY/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
