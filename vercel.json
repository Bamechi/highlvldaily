{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/daily/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/DAILY/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/daily/press/(.*)", "dest": "/press/$1" },
    { "src": "/DAILY/press/(.*)", "dest": "/press/$1" },
    { "src": "/daily/?", "dest": "/index.html" },
    { "src": "/DAILY/?", "dest": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
