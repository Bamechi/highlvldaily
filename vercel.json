{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/daily/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/DAILY/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/daily/press/:path*", "destination": "/press/:path*" },
    { "source": "/DAILY/press/:path*", "destination": "/press/:path*" },
    { "source": "/daily", "destination": "/index.html" },
    { "source": "/DAILY", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
